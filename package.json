{
  "name": "gladys-slack",
  "version": "0.2.0",
  "private": true,
  "description": "Unofficial Gladys Assistant external integration for Slack: talk to Gladys with a bot of your own workspace over Socket Mode (no public URL), scene triggers and actions, a dashboard widget. Not affiliated with Slack Technologies.",
  "homepage": "https://github.com/William-De71/gladys-slack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-slack.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "slack",
    "chat",
    "bot",
    "socket-mode",
    "home-automation"
  ]
}
